{
  "ChatAttachments": {
    "RootPath": null,
    "MaxFileBytes": 5242880,
    "MaxImagesPerMessage": 4,
    "MaxImagesPerRequest": 20,
    "MaxDimension": 2048,
    "MaxDecodedPixels": 40000000,
    "RetentionHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "Documents": {
    "MaxUploadBytes": 10485760,
    "MaxExtractedCharacters": 2000000,
    "MaxVectorizationChunks": 500
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=bitcraft;Username=bitcraft_user;Password=bitcraft_password"
  },
  "ModelProviders": {
    "Ollama": {
      "BaseUrl": "http://ollama:11434",
      "ChatModel": "llama3.2",
      "EmbeddingModel": "nomic-embed-text",
      "HealthCheckTimeoutSeconds": 5,
      "EmbeddingTimeoutSeconds": 30,
      "GenerateTimeoutSeconds": 120
    }
  }
}
