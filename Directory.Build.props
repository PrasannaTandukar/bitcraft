<Project>
  <!--
    Bitcraft repository-wide MSBuild defaults.

    BITCRAFT_RUNTIME_LOCAL_ONLY is a build-time guard for code paths that may run
    only in single-machine local PoC configurations (e.g. permissive defaults,
    developer ergonomics, in-process shortcuts). The symbol is defined ONLY when
    the build Configuration is 'Local'. Standard 'Debug' and 'Release' builds —
    including all CI — leave the symbol undefined.

    Defense-in-depth: this file lives at the repository root so it applies to
    every project under src/ and tests/ via MSBuild's automatic Directory.Build.props
    discovery.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Local'">
    <DefineConstants>$(DefineConstants);BITCRAFT_RUNTIME_LOCAL_ONLY</DefineConstants>
  </PropertyGroup>
  <!-- OllamaSharp 5.4.30 ships an optional tool generator requiring Roslyn 5.6.
       No generated tools are used in this phase. Remove it in consuming projects too,
       where NuGet's analyzer exclusion does not prevent transitive discovery. -->
  <Target Name="ExcludeUnusedOllamaToolGenerator" BeforeTargets="CoreCompile">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'OllamaSharp.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
