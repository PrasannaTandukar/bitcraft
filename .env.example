# ───────────────────────────────────────────────
# Bitcraft — Environment Variables
# ───────────────────────────────────────────────
# Copy to .env and edit as needed:
#   cp .env.example .env
#
# All values below show the defaults used when
# the variable is unset.
# ───────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=bitcraft
POSTGRES_USER=bitcraft_user
POSTGRES_PASSWORD=bitcraft_password
# Host port for local DB access: 5433

# ── AI / Ollama ───────────────────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_DOCKER_TAG=latest
