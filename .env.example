# ───────────────────────────────────────────────
# Bitcraft — Environment Variables
# ───────────────────────────────────────────────
# Copy to .env and edit as needed:
#   cp .env.example .env
#
# All values below show the defaults used when
# the variable is unset.
# ───────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_DB=bitcraft
POSTGRES_USER=bitcraft_user
POSTGRES_PASSWORD=bitcraft_password
# Host port for local DB access: 5433

# ── AI / Ollama ───────────────────────────────
# The backend reads model endpoints from the RuntimeEngines table (OD-4).
# These variables configure the ollama-pull-* helper services only.
# OLLAMA_DOCKER_TAG=latest
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Tutor Studio (Vite dev server) ────────────
# Set to true on WSL2 and on some macOS setups where
# inotify/fsevents miss host bind-mount changes.
# VITE_USE_POLLING=false

# Temporary tutor chat images (filesystem volume; no binary data in PostgreSQL)
CHAT_ATTACHMENTS_MAX_FILE_BYTES=5242880
CHAT_ATTACHMENTS_MAX_IMAGES=4
CHAT_ATTACHMENTS_MAX_DIMENSION=2048
CHAT_ATTACHMENTS_RETENTION_HOURS=24
