.idea/
*.iml
*.iws
*.ipr
*.sln.iml

# =========================
# VSCode (optional)
# =========================
.vscode/*
!.vscode/extensions.json

# =========================
# OS files
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# .NET (if you use Rider backend/services)
# =========================
bin/
obj/
*.user
*.suo
*.cache
*.pdb

# =========================
# Python (FastAPI backend)
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
.env.*

# =========================
# Node / React (Next.js frontend)
# =========================
node_modules/
.next/
out/
dist/
dist-ssr/
build/
coverage/

# =========================
# Package managers
# =========================
package-lock.json
yarn.lock
pnpm-lock.yaml

# =========================
# Docker
# =========================
.docker/
*.pid
*.seed
*.pid.lock

# =========================
# Misc
# =========================
*.sw?
*.local